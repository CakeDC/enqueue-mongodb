<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.5/phpunit.xsd" colors="true" bootstrap="./vendor/autoload.php" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Message Queue Mongodb Transport Test Suite">
      <directory>./Tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <!--
        <env name="MONGO_DSN" value="mongodb://127.0.0.1:27017/enqueue_test"/>
		-->
  </php>
  <source>
    <include>
      <directory suffix=".php">.</directory>
    </include>
    <exclude>
      <directory>./vendor</directory>
      <directory>./Tests</directory>
    </exclude>
  </source>
</phpunit>
